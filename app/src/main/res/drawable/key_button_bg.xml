<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Active / Locked Modifier State (e.g. Ctrl pressed/locked) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/key_active_bg" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- Pressed State -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/key_pressed_bg" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#718096" />
        </shape>
    </item>
    <!-- Default Normal State -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/key_normal_bg" />
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="#4A5568" />
        </shape>
    </item>
</selector>
