<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.NetHunterRDP" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/kali_primary</item>
        <item name="colorPrimaryVariant">@color/kali_primary_dark</item>
        <item name="colorSecondary">@color/kali_accent</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
    </style>

    <!-- Fullscreen Remote Session Theme (Immersion Mode) -->
    <style name="Theme.NetHunterRDP.Fullscreen" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- SuperBar Key Button Style -->
    <style name="SuperBarKey">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:background">@drawable/key_button_bg</item>
        <item name="android:textColor">@color/key_text_color</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">false</item>
    </style>
</resources>
